{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ml-autoresearch.schema.json",
  "title": "ML Autoresearch Harness configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "project", "evaluator", "metrics", "budget", "researchInstructions"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "outputDir": { "type": "string", "minLength": 1, "default": "runs" },
    "researchInstructions": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDir", "mutablePaths"],
      "properties": {
        "sourceDir": { "type": "string", "minLength": 1 },
        "mutablePaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "protectedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
        "hiddenPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [], "description": "Files copied into the workspace for evaluation but hidden from the research agent's listing and read tools." },
        "copyIgnore": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "thinkingLevel": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"], "default": "high" },
        "systemPrompt": { "type": "string", "minLength": 1 },
        "pool": { "type": "array", "items": { "$ref": "#/$defs/agentProfile" }, "default": [] },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "implementer": { "$ref": "#/$defs/agentProfile" },
            "reviewer": { "$ref": "#/$defs/agentProfile" },
            "hypothesis-generator": { "$ref": "#/$defs/agentProfile" },
            "statistician": { "$ref": "#/$defs/agentProfile" },
            "failure-analyst": { "$ref": "#/$defs/agentProfile" },
            "implementation-critic": { "$ref": "#/$defs/agentProfile" }
          },
          "default": {}
        },
        "backend": { "$ref": "#/$defs/agentBackend" },
        "lab": { "$ref": "#/$defs/researchLab" },
        "orchestration": { "$ref": "#/$defs/agentOrchestration" },
        "analysis": { "$ref": "#/$defs/agentAnalysis" }
      }
    },
    "runtimeDependencies": { "$ref": "#/$defs/runtimeDependencies" },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 600 },
        "repetitions": { "type": "integer", "minimum": 1, "default": 1 },
        "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
        "inheritEnv": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evaluationStage" }, "default": [{ "name": "canonical", "budgetRatio": 1, "pruneIfClearlyWorse": false }] },
        "statistics": { "$ref": "#/$defs/statisticalPolicy" },
        "repetitionConcurrency": { "type": "integer", "minimum": 1, "default": 1 },
        "preflight": { "$ref": "#/$defs/evaluatorPreflight" },
        "checkpointing": { "$ref": "#/$defs/evaluatorCheckpointing" },
        "telemetry": { "$ref": "#/$defs/evaluatorTelemetry" },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional evaluator-managed shared cache. The harness only provisions and exposes the directory; evaluators may ignore it.",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "path": { "type": "string", "minLength": 1, "default": ".autoresearch/cache", "description": "Cache root resolved relative to the configuration file." },
            "namespace": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "default": "default" },
            "readOnly": { "type": "boolean", "default": false },
            "results": { "type": "boolean", "default": false, "description": "Reuse exact per-seed evaluation results using workspace, evaluator, stage and cache namespace fingerprints." }
          }
        },
        "agentRequests": {
          "type": "object",
          "additionalProperties": false,
          "description": "Bounded evaluator-level requests that the research agent may preregister without editing evaluator code.",
          "properties": {
            "allowPairedComparison": { "type": "boolean", "default": false },
            "maxSeeds": { "type": "integer", "minimum": 1, "default": 5 }
          }
        },
        "runner": { "$ref": "#/$defs/runner" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/$defs/primaryMetric" },
        "guardrails": { "type": "array", "items": { "$ref": "#/$defs/guardrailMetric" }, "default": [] },
        "objectives": { "type": "array", "items": { "$ref": "#/$defs/objectiveMetric" }, "default": [], "description": "Additional metrics used for multi-objective/Pareto comparisons." },
        "pareto": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean", "default": false } },
          "default": {}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxExperiments": { "type": "integer", "minimum": 1, "default": 20 },
        "maxWallTimeMinutes": { "type": "number", "minimum": 0, "default": 480, "description": "Maximum run duration in minutes; 0 disables the wall-time limit." },
        "maxConsecutiveFailures": { "type": "integer", "minimum": 1, "default": 3 }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beamWidth": { "type": "integer", "minimum": 1, "default": 3 },
        "maxBranchDepth": { "type": "integer", "minimum": 1, "default": 3 },
        "maxTemporaryRegressionRatio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 },
        "recentExperiments": { "type": "integer", "minimum": 1, "default": 12 },
        "maxContextLessons": { "type": "integer", "minimum": 1, "default": 40 },
        "supportThreshold": { "type": "integer", "minimum": 1, "default": 2 },
        "contradictionThreshold": { "type": "integer", "minimum": 1, "default": 1 },
        "maxFrontierPerCategory": { "type": "integer", "minimum": 1, "default": 1 },
        "strategy": { "$ref": "#/$defs/strategy" },
        "humanLessons": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "claim": { "type": "string", "minLength": 1 },
              "guidance": { "enum": ["consider", "avoid", "verify"], "default": "consider" }
            }
          }
        },
        "campaign": { "$ref": "#/$defs/campaignPolicy" },
        "meta": { "$ref": "#/$defs/metaResearchPolicy" },
        "acquisition": { "$ref": "#/$defs/learnedAcquisition" },
        "ensemble": { "$ref": "#/$defs/ensemblePolicy" },
        "sliceDiscovery": { "$ref": "#/$defs/sliceDiscovery" },
        "refinement": { "$ref": "#/$defs/researchMethodRefinement" }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "seed": { "type": "integer", "minimum": 0, "default": 2027 },
        "exploitationRatio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.55 },
        "retireAfterSemanticNoOps": { "type": "integer", "minimum": 0, "default": 2, "description": "Retire an unconsumed or single-parameter semantic no-op after this many observations. Zero disables retirement." },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/searchParameter" }, "default": [] },
        "surrogate": { "$ref": "#/$defs/surrogateSearch" },
        "sweeps": { "$ref": "#/$defs/parameterSweepPolicy" }
      },
      "default": {}
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experimentConcurrency": { "type": "integer", "minimum": 1, "default": 1 },
        "resourceSlots": { "type": "array", "items": { "type": "string" }, "default": [] },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" }, "default": [] },
        "asha": { "$ref": "#/$defs/ashaScheduler" }
      },
      "default": {}
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "path": { "type": "string", "minLength": 1, "default": ".autoresearch/project-knowledge.json" },
        "scope": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "minimumConfidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 }
      },
      "default": {}
    }
  },
  "$defs": {
    "agentProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "thinkingLevel": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] },
        "systemPrompt": { "type": "string", "minLength": 1 }
      }
    },
    "agentOrchestration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Selects bounded read-only specialist advisors from configured agent.roles according to current research state.",
      "properties": {
        "mode": { "enum": ["single", "adaptive"], "default": "single" },
        "maxAdvisors": { "type": "integer", "minimum": 1, "default": 2 },
        "maxParallel": { "type": "integer", "minimum": 1, "default": 1 },
        "failureAnalystAfter": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "agentProcessRunner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["local", "docker"] },
        "image": { "type": "string", "minLength": 1 },
        "allowHostExecution": { "type": "boolean", "default": false },
        "cpus": { "type": "number", "minimum": 0.1 },
        "memory": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1, "default": "none" },
        "gpus": { "type": "string", "minLength": 1 },
        "readOnlyRoot": { "type": "boolean", "default": true },
        "pidsLimit": { "type": "integer", "minimum": 16, "default": 256 }
      }
    },
    "agentBackend": {
      "type": "object",
      "additionalProperties": false,
      "description": "Researcher implementation. prime-agent-rpc is an opt-in Docker-only backend and runs against an agent-visible workspace mirror.",
      "properties": {
        "type": { "enum": ["pi-sdk", "prime-agent-rpc"], "default": "pi-sdk" },
        "command": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 3600 },
        "inheritEnv": { "type": "array", "items": { "type": "string" }, "default": [] },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "description": "Prime Agent telemetry policy. The harness disables it by default for every launched backend process.",
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          },
          "default": { "enabled": false }
        },
        "runner": { "$ref": "#/$defs/agentProcessRunner" }
      },
      "default": {}
    },
    "researchLab": {
      "type": "object",
      "additionalProperties": false,
      "description": "Run-scoped durable files and persistent Python kernel, isolated from candidate workspaces and hidden evaluator assets.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "engine": { "const": "python", "default": "python" },
        "path": { "type": "string", "minLength": 1, "default": ".autoresearch/lab" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 300 },
        "maxCalls": { "type": "integer", "minimum": 1, "default": 200 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "default": 262144 },
        "inheritEnv": { "type": "array", "items": { "type": "string" }, "default": [] },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "runner": { "$ref": "#/$defs/agentProcessRunner" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["local", "docker", "remote"], "default": "local" },
        "image": { "type": "string", "minLength": 1 },
        "cpus": { "type": "number", "minimum": 0.1 },
        "memory": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1, "default": "none" },
        "gpus": { "type": "string", "minLength": 1 },
        "readOnlyRoot": { "type": "boolean", "default": true },
        "pidsLimit": { "type": "integer", "minimum": 16, "default": 512 },
        "remote": { "$ref": "#/$defs/remoteExecutor" }
      }
    },
    "remoteExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "description": "Trusted JSONL broker that uploads or maps the read-only workspace, executes one isolated evaluation attempt, and returns bounded artifacts.",
      "properties": {
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 600 },
        "inheritEnv": { "type": "array", "items": { "type": "string" }, "default": [] },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "maxResponseBytes": { "type": "integer", "minimum": 1024, "default": 8388608 }
      }
    },
    "agentAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opt-in arbitrary analysis commands for the implementer. Docker is the safe default; local execution requires explicit host trust.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 300 },
        "maxCalls": { "type": "integer", "minimum": 1, "default": 30 },
        "minimumCallsBeforeProposal": { "type": "integer", "minimum": 0, "default": 0, "description": "Require this many research_exec calls before accepting an agent proposal. Zero disables the requirement." },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "default": 262144 },
        "inheritEnv": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "runner": { "$ref": "#/$defs/analysisRunner" }
      }
    },
    "analysisRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["local", "docker"], "default": "docker" },
        "image": { "type": "string", "minLength": 1 },
        "allowHostExecution": { "type": "boolean", "default": false, "description": "Required for local mode. Confirms that arbitrary agent commands may access the host account." },
        "cpus": { "type": "number", "minimum": 0.1 },
        "memory": { "type": "string", "minLength": 1 },
        "network": { "type": "string", "minLength": 1, "default": "none" },
        "gpus": { "type": "string", "minLength": 1 },
        "readOnlyRoot": { "type": "boolean", "default": true },
        "pidsLimit": { "type": "integer", "minimum": 16, "default": 256 }
      }
    },
    "runtimeDependencyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "package"],
      "properties": {
        "manager": { "enum": ["python", "bun"] },
        "package": { "type": "string", "minLength": 1 },
        "versions": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeEnvironmentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "cpus": { "type": "number", "minimum": 0.1 },
        "memory": { "type": "string", "minLength": 1 },
        "gpus": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath"],
      "description": "Controlled, locked dependency overlays shared by research_exec and the evaluator.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "strategy": { "const": "locked-overlay", "default": "locked-overlay" },
        "manifestPath": { "type": "string", "minLength": 1 },
        "allowedManagers": { "type": "array", "items": { "enum": ["python", "bun"] }, "default": ["python"] },
        "registries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": { "type": "string", "minLength": 1 },
            "bun": { "type": "string", "minLength": 1 }
          },
          "default": {}
        },
        "allow": { "type": "array", "items": { "$ref": "#/$defs/runtimeDependencyRule" }, "default": [] },
        "deny": { "type": "array", "items": { "$ref": "#/$defs/runtimeDependencyRule" }, "default": [] },
        "maxDirectDependencies": { "type": "integer", "minimum": 1, "default": 10 },
        "maxInstallSeconds": { "type": "integer", "minimum": 1, "default": 300 },
        "maxEnvironmentBytes": { "type": "integer", "minimum": 1048576, "default": 2147483648 },
        "requireLockedVersions": { "const": true, "default": true },
        "cachePath": { "type": "string", "minLength": 1, "default": ".autoresearch/dependencies" },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installer": { "const": "pip", "default": "pip" },
            "onlyBinary": { "type": "boolean", "default": true }
          },
          "default": {}
        },
        "bun": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "ignoreScripts": { "type": "boolean", "default": true } },
          "default": {}
        },
        "environmentProfiles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/runtimeEnvironmentProfile" },
          "default": {}
        }
      }
    },
    "evaluatorPreflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 60 }
      }
    },
    "evaluatorCheckpointing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "manifestName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "default": "checkpoint.json" }
      }
    },
    "evaluatorTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean", "default": true } }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cpu": { "type": "number", "minimum": 0.1, "default": 1 },
        "memoryGb": { "type": "number", "minimum": 0.1, "default": 1 },
        "gpu": { "type": "integer", "minimum": 0, "default": 0 },
        "vramGb": { "type": "number", "minimum": 0, "default": 0 },
        "maxConcurrent": { "type": "integer", "minimum": 1, "default": 1 }
      }
    },
    "ashaScheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "familySize": { "type": "integer", "minimum": 2, "default": 4 },
        "reductionFactor": { "type": "integer", "minimum": 2, "default": 2 },
        "agentCandidates": { "type": "boolean", "default": true }
      }
    },
    "surrogateSearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "minimumObservations": { "type": "integer", "minimum": 1, "default": 5 },
        "candidatePoolSize": { "type": "integer", "minimum": 2, "default": 64 },
        "explorationWeight": { "type": "number", "minimum": 0, "default": 0.25 }
      }
    },
    "parameterSweepPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "maxValues": { "type": "integer", "minimum": 2, "default": 5 },
        "maxConcurrentTrials": { "type": "integer", "minimum": 1, "default": 1 },
        "reductionFactor": { "type": "integer", "minimum": 2, "default": 2 }
      }
    },
    "learnedAcquisition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "minimumObservations": { "type": "integer", "minimum": 1, "default": 5 },
        "explorationFloor": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 }
      }
    },
    "ensemblePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "minimumMembers": { "type": "integer", "minimum": 2, "default": 2 },
        "maximumMembers": { "type": "integer", "minimum": 2, "default": 4 },
        "interval": { "type": "integer", "minimum": 1, "default": 5 }
      }
    },
    "researchMethodRefinement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Evidence-gated refinement of advisory research procedures. It never changes evaluator, metric, hidden-data, protected-path, credential, network, or sandbox policy.",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "minimumEvidence": { "type": "integer", "minimum": 1, "default": 2 },
        "contradictionThreshold": { "type": "integer", "minimum": 1, "default": 1 },
        "maxEntries": { "type": "integer", "minimum": 1, "default": 40 },
        "allowedKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["prompt-note", "analysis-recipe", "context-selector", "role-spec", "screening-policy"] },
          "default": ["prompt-note", "analysis-recipe", "context-selector", "role-spec", "screening-policy"]
        }
      }
    },
    "sliceDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "minimumSamples": { "type": "integer", "minimum": 1, "default": 30 },
        "maximumTickets": { "type": "integer", "minimum": 1, "default": 3 },
        "regressionThreshold": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "primaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["minimize", "maximize"] },
        "format": { "enum": ["number", "percentage"], "default": "number", "description": "Display format. Percentage values are emitted by the evaluator as fractions, where 0.42 means 42%." },
        "aggregation": { "enum": ["mean", "median", "min", "max"], "default": "median" },
        "minimumDelta": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "guardrailMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["minimize", "maximize"] },
        "format": { "enum": ["number", "percentage"], "default": "number", "description": "Display format. Percentage values are emitted by the evaluator as fractions, where 0.42 means 42%." },
        "aggregation": { "enum": ["mean", "median", "min", "max"], "default": "median" },
        "maxRegression": { "type": "number", "minimum": 0 },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "objectiveMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["minimize", "maximize"] },
        "format": { "enum": ["number", "percentage"], "default": "number", "description": "Display format. Percentage values are emitted by the evaluator as fractions, where 0.42 means 42%." },
        "aggregation": { "enum": ["mean", "median", "min", "max"], "default": "median" },
        "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      }
    },
    "evaluationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "budgetRatio"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "budgetRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "pruneIfClearlyWorse": { "type": "boolean", "default": true }
      }
    },
    "statisticalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "confidenceLevel": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.95 },
        "equivalenceMargin": { "type": "number", "minimum": 0 },
        "minimumSeeds": { "type": "integer", "minimum": 1 },
        "maximumSeeds": { "type": "integer", "minimum": 1 },
        "seedStep": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "explorationRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 },
        "backtrackRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
        "replicationRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
        "falsificationRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
        "optimizeRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.1 },
        "mergeRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 },
        "ablationRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 }
      }
    },
    "campaignPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "queueRate": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 },
        "maxQueued": { "type": "integer", "minimum": 1, "default": 40 },
        "hypothesesPerProposal": { "type": "integer", "minimum": 1, "default": 4 },
        "autoAblations": { "type": "boolean", "default": true },
        "maxAblationsPerPromotion": { "type": "integer", "minimum": 1, "default": 3 },
        "autoMerge": { "type": "boolean", "default": true }
      }
    },
    "metaResearchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "updateInterval": { "type": "integer", "minimum": 1, "default": 5 },
        "warmupExperiments": { "type": "integer", "minimum": 1, "default": 5 },
        "explorationFloor": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.05 }
      }
    },
    "searchParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "type": { "enum": ["float", "integer", "categorical", "boolean"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "scale": { "enum": ["linear", "log"] },
        "values": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } },
        "requiresCapability": { "type": "string", "minLength": 1, "description": "Evaluator-declared candidate capability required for this parameter to be active on a checkpoint." }
      }
    }
  }
}
