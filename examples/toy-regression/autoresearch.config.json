{
  "$schema": "../../autoresearch.schema.json",
  "version": 2,
  "name": "toy-polynomial-regression",
  "project": {
    "sourceDir": ".",
    "mutablePaths": ["model.py", "experiment.json"],
    "protectedPaths": ["evaluate.py", "preflight.py", "holdout.py"],
    "hiddenPaths": ["holdout.py"],
    "copyIgnore": ["runs", ".autoresearch"]
  },
  "agent": {
    "model": "openai-codex/gpt-5.6-sol",
    "thinkingLevel": "xhigh"
  },
  "evaluator": {
    "command": ["/opt/homebrew/bin/python3", "evaluate.py"],
    "timeoutSeconds": 30,
    "repetitions": 3,
    "seeds": [17, 29, 43],
    "inheritEnv": ["PATH", "HOME", "TMPDIR"],
    "env": {},
    "preflight": {
      "enabled": true,
      "command": ["/opt/homebrew/bin/python3", "preflight.py"],
      "timeoutSeconds": 10
    },
    "checkpointing": {
      "enabled": true,
      "manifestName": "checkpoint.json"
    },
    "telemetry": {
      "enabled": true
    },
    "cache": {
      "enabled": true,
      "path": ".autoresearch/cache",
      "namespace": "toy-polynomial-v1-evaluator-v3",
      "readOnly": false,
      "results": true
    },
    "stages": [
      {
        "name": "smoke",
        "budgetRatio": 0.15,
        "repetitions": 1,
        "timeoutSeconds": 10,
        "pruneIfClearlyWorse": true
      },
      {
        "name": "screening",
        "budgetRatio": 0.35,
        "repetitions": 2,
        "timeoutSeconds": 20,
        "pruneIfClearlyWorse": true
      },
      {
        "name": "canonical",
        "budgetRatio": 1,
        "repetitions": 3,
        "timeoutSeconds": 30,
        "pruneIfClearlyWorse": false
      }
    ],
    "statistics": {
      "enabled": true,
      "confidenceLevel": 0.95,
      "equivalenceMargin": 0.001,
      "minimumSeeds": 2,
      "maximumSeeds": 3,
      "seedStep": 1
    },
    "repetitionConcurrency": 2,
    "agentRequests": {
      "allowPairedComparison": true,
      "maxSeeds": 5
    },
    "runner": {
      "mode": "local"
    }
  },
  "metrics": {
    "primary": {
      "name": "validation_rmse",
      "direction": "minimize",
      "format": "number",
      "minimumDelta": 0.001,
      "aggregation": "median"
    },
    "guardrails": [
      {
        "name": "parameter_count",
        "direction": "minimize",
        "format": "number",
        "aggregation": "max",
        "max": 5
      }
    ],
    "objectives": [
      {
        "name": "slice_center_rmse",
        "direction": "minimize",
        "format": "number",
        "aggregation": "median",
        "weight": 1
      },
      {
        "name": "slice_edge_rmse",
        "direction": "minimize",
        "format": "number",
        "aggregation": "median",
        "weight": 1
      }
    ],
    "pareto": {
      "enabled": true
    }
  },
  "budget": {
    "maxExperiments": 4,
    "maxWallTimeMinutes": 10,
    "maxConsecutiveFailures": 3
  },
  "learning": {
    "beamWidth": 3,
    "maxBranchDepth": 3,
    "maxTemporaryRegressionRatio": 0.05,
    "recentExperiments": 12,
    "maxContextLessons": 40,
    "supportThreshold": 2,
    "contradictionThreshold": 1,
    "maxFrontierPerCategory": 1,
    "strategy": {
      "explorationRate": 0.25,
      "backtrackRate": 0.1,
      "replicationRate": 0.1,
      "falsificationRate": 0.1,
      "optimizeRate": 0.1,
      "mergeRate": 0.05,
      "ablationRate": 0.05
    },
    "humanLessons": [],
    "campaign": {
      "enabled": true,
      "queueRate": 0.35,
      "maxQueued": 20,
      "hypothesesPerProposal": 4,
      "autoAblations": true,
      "maxAblationsPerPromotion": 3,
      "autoMerge": true
    },
    "meta": {
      "enabled": true,
      "updateInterval": 5,
      "warmupExperiments": 5,
      "explorationFloor": 0.05
    },
    "acquisition": {
      "enabled": true,
      "minimumObservations": 5,
      "explorationFloor": 0.1
    },
    "ensemble": {
      "enabled": true,
      "minimumMembers": 2,
      "maximumMembers": 3,
      "interval": 5
    },
    "sliceDiscovery": {
      "enabled": true,
      "minimumSamples": 30,
      "maximumTickets": 2,
      "regressionThreshold": 0.001
    }
  },
  "search": {
    "enabled": true,
    "seed": 2027,
    "exploitationRatio": 0.55,
    "retireAfterSemanticNoOps": 2,
    "surrogate": {
      "enabled": true,
      "minimumObservations": 5,
      "candidatePoolSize": 64,
      "explorationWeight": 0.25
    },
    "parameters": [
      {
        "name": "polynomial_degree",
        "file": "experiment.json",
        "path": "polynomial_degree",
        "type": "integer",
        "min": 1,
        "max": 6,
        "requiresCapability": "toy-polynomial-spec-v1"
      },
      {
        "name": "l2_regularization",
        "file": "experiment.json",
        "path": "l2_regularization",
        "type": "float",
        "min": 0.0001,
        "max": 0.1,
        "scale": "log",
        "requiresCapability": "toy-polynomial-spec-v1"
      },
      {
        "name": "feature_basis",
        "file": "experiment.json",
        "path": "feature_basis",
        "type": "categorical",
        "values": ["power", "chebyshev", "legendre"],
        "requiresCapability": "toy-polynomial-spec-v1"
      },
      {
        "name": "input_scale",
        "file": "experiment.json",
        "path": "input_scale",
        "type": "float",
        "min": 0.75,
        "max": 1.25,
        "requiresCapability": "toy-polynomial-spec-v1"
      },
      {
        "name": "regularize_intercept",
        "file": "experiment.json",
        "path": "regularize_intercept",
        "type": "boolean",
        "requiresCapability": "toy-polynomial-spec-v1"
      }
    ]
  },
  "execution": {
    "experimentConcurrency": 2,
    "resourceSlots": [],
    "resources": [
      {
        "id": "local-cpu",
        "cpu": 2,
        "memoryGb": 2,
        "gpu": 0,
        "vramGb": 0,
        "maxConcurrent": 2
      }
    ],
    "asha": {
      "enabled": true,
      "familySize": 2,
      "reductionFactor": 2,
      "agentCandidates": false
    }
  },
  "knowledge": {
    "enabled": true,
    "path": ".autoresearch/project-knowledge.json",
    "scope": {
      "dataset": "toy-polynomial-v1",
      "evaluator": "toy-evaluator-v3"
    },
    "minimumConfidence": 0.7
  },
  "outputDir": "runs",
  "researchInstructions": "Improve validation RMSE for this small regression problem. You may tune the declarative candidate in experiment.json and change feature or regularization logic in model.py; multiple mutable files are allowed when they form one coherent experiment. Prefer the simplest candidate that explains the data. Use the declared search space for numeric/categorical alternatives when it is informative, and treat slice metrics as objectives rather than optimizing only the global score. Do not import holdout.py, reproduce hidden targets, or change the evaluator. Use an optional paired comparison on fresh seeds when a result needs confirmation or a frontier checkpoint should be compared fairly with the leader. When a multi-file change is promoted, allow the campaign to queue ablations or a merge only when their source checkpoints and hypothesis are explicit."
}
